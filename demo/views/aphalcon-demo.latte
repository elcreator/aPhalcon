{*
   aphalcon-demo.latte - the root of the chain for a Phalcon route, rendered
   through $app->cms->respond('aphalcon-demo', [...]).

   No document behind it: no $pagetitle, no $content, only what the route
   passed in ($title, $documents) - and the same two parents the CMS document
   uses, aphalcon-section.latte and aphalcon-base.latte, which is the point.
*}
{extends 'aphalcon-section.latte'}

{block bodyClass}aph-base aph-section aph-route{/block}

{block intro}{phalcon('greeter')->greet('visitor')}{/block}

{block body}
    <p>
        This page is a <strong>Phalcon Micro route</strong> inside Evolution CMS, and the chain it renders is
        <code>aphalcon-demo.latte</code> → <code>aphalcon-section.latte</code> → <code>aphalcon-base.latte</code>.
        The rows below come from <code>Elcreator\aPhalcon\Demo\Document</code>, a <code>Phalcon\Mvc\Model</code> over
        the site's own <code>site_content</code> table, on the DI's <code>db</code> adapter - opened with the
        CMS's credentials.
    </p>
    <ul n:if="count($documents)">
        <li n:foreach="$documents as $document">
            <a href="{phalcon('cms')->url($document->id)}">{$document->pagetitle}</a>
            <small>#{$document->id} - <a href="{phalcon('cms')->setting('site_url')}app/documents/{$document->id}">route</a>
            - <a href="{phalcon('cms')->setting('site_url')}app/page/{$document->id}">as a page</a></small>
        </li>
    </ul>
    <p n:if="!count($documents)"><em>No documents.</em></p>
    <p>
        <a href="{phalcon('cms')->setting('site_url')}app/documents.json">documents.json</a> is the same query as an array return.
    </p>
{/block}

# Per-repository knobs for the pipeline in ci/ and .github/.
#
# Everything else under ci/ is identical across the Evolution CMS plugin
# repositories that share this pipeline, so a fix made in one is a fix that can
# be copied verbatim into the others. Only this file differs.

# Composer package name, exactly as declared in the plugin's composer.json.
PLUGIN_PACKAGE='elcreator/aphalcon'

# Service provider, for `artisan vendor:publish --provider=`. Single-quoted:
# the backslashes are part of the class name, not escapes.
PLUGIN_PROVIDER='Elcreator\aPhalcon\aPhalconServiceProvider'

# Directory name under core/custom/packages/, and the local docker image name.
PLUGIN_SLUG='aphalcon'

# The CMS this plugin is built into. Point EVO_REPO at a fork to test a core
# change and a plugin change together.
EVO_REPO="${EVO_REPO:-https://github.com/evolution-cms/evolution}"
EVO_REF="${EVO_REF:-3.5.x}"

# How the unit suite runs — see ci/run-tests.sh:
#   borrowed-core  the plugin has no vendor tree and borrows the core's
#                  autoloader and Pest binary (EVO_CORE_PATH_TEST)
#   own-vendor     the plugin has its own vendor tree and `composer test`
#   none           the plugin ships no suite; only the install smoke test runs
#
# aPhalcon has no vendor tree of its own: aLatteX and Latte are ordinary
# dependencies resolved into the core the plugin is installed into, and Pest
# comes from that same core. So the suite borrows the core's autoloader through
# EVO_CORE_PATH_TEST, and the integration tests render through the real Latte
# the CMS build pulled in rather than skipping themselves.
TEST_MODE='borrowed-core'

# Sibling plugins this one depends on, as package=slug=path=version. A path that
# exists at build time (ci/compose.yaml mounts the developer's checkout there)
# is copied into core/custom/packages/<slug> and required from there, so the
# build runs against the working copy; a path that does not is left to
# composer, which resolves the package from packagist. The version is what the
# checkout is presented as, so it satisfies this plugin's own constraint on it.
#
# aPhalcon needs the LattexEngine::addExtension() hook, which a released
# aLatteX may not have yet - without it the {phalcon()} Latte function is not
# registered and the demo page renders without it.
PLUGIN_SIBLINGS='elcreator/alattex=alattex=/plugin-deps/alattex=0.4.99'
